# Frontend environment variables in this Vite project must be prefixed with VITE_ to be accessible in client-side code.
# This file serves as a template for local development and build-time injection.
# Copy this file to .env and fill in the values for local development.

VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_OBFUSCATION_KEY=your_obfuscation_key_here
